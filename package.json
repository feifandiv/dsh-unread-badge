{
  "name": "@fanfan4589/dsh-unread-badge",
  "version": "0.3.0",
  "description": "Unread badge and task radar for DeepSeek Harness: a Dock number badge, a persistent sidebar task row (running / blocked / done with a click-through list), a floating handle while the sidebar is collapsed, and the last three sessions you visited. · 未读角标 + 侧栏任务总览 + 悬浮球 + 历史。",
  "type": "module",
  "license": "MIT",
  "author": "feifandiv",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "unread",
    "badge",
    "dock",
    "workspace",
    "history",
    "floating"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "README.zh.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "homepage": "https://github.com/feifandiv/dsh-unread-badge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feifandiv/dsh-unread-badge.git"
  },
  "bugs": {
    "url": "https://github.com/feifandiv/dsh-unread-badge/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
